<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout  android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".CourseActivity">

        <ImageView
            android:id="@+id/logoMaisonneuve"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/logo"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First name :"
            android:layout_below="@+id/logoMaisonneuve"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/firstnametext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Saisissez le First name du prof"
            android:layout_below="@id/logoMaisonneuve"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edittext_background"
            android:padding="16dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last name  :"
            android:layout_below="@+id/firstnametext"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/lastname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Saisissez le last name du prof"
            android:layout_below="@id/firstnametext"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/edittext_background"
            android:padding="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email:"
            android:layout_below="@+id/lastname"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Saisissez le de l'email du prof"
            android:layout_below="@id/lastname"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/edittext_background"
            android:padding="16dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Department :"
            android:layout_below="@+id/email"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/department"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Saisissez le departament"
            android:layout_below="@id/email"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/edittext_background"
            android:padding="16dp"/>


        <Button
            android:id="@+id/addcourse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajouter Professor"
            android:backgroundTint="@color/colorPrimary"
            android:layout_centerHorizontal="true"
            android:layout_below="@id/department"/>

    </RelativeLayout>

</ScrollView>